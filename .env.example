# ---------------------------------------------------------------------------
# PriceShelf environment variables
# Copy this file to `.env.local` and fill in the values you have.
# Every provider is optional: PriceShelf runs with whichever ones are configured
# and reports the rest as "did not respond" in the UI.
# ---------------------------------------------------------------------------

# Public base URL of the deployment. Used for canonical URLs, sitemap, OG tags.
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- SerpApi (Google Shopping engine) --------------------------------------
# Covers Walmart, Target, Costco, Best Buy, Shein, eBay, Home Depot and more.
# Get a key: https://serpapi.com/manage-api-key
SERPAPI_KEY=

# --- Rainforest API (Amazon product data) ----------------------------------
# Get a key: https://www.rainforestapi.com/ -> Dashboard -> API Credentials
RAINFOREST_API_KEY=

# Amazon Associates tracking id appended to Amazon outbound links (e.g. mytag-20)
# Get one: https://affiliate-program.amazon.com/
AMAZON_ASSOCIATE_TAG=

# --- Walmart affiliate (Impact) --------------------------------------------
# Publisher id used for Walmart outbound links.
# Get one: https://impact.com/ -> Walmart advertiser -> Account -> Publisher ID
WALMART_AFFILIATE_ID=
# Optional: Walmart Affiliate (Impact) API credentials. When both are set the
# Walmart provider queries the Walmart catalog directly instead of relying on
# Google Shopping results.
WALMART_API_KEY=
WALMART_API_SECRET=

# --- Upstash Redis (Vercel KV) ---------------------------------------------
# Used to cache search results for 15 minutes and to rate limit /api/search.
# Create a database: https://console.upstash.com/redis  (or Vercel -> Storage -> KV)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional affiliate tags for other retailers ---------------------------
# Appended as-is to outbound links when present.
EBAY_CAMPAIGN_ID=
TARGET_AFFILIATE_ID=
BESTBUY_AFFILIATE_ID=

# --- Local/demo only --------------------------------------------------------
# Set to 1 to serve a small fixed catalogue instead of calling live APIs.
# Used by the Playwright end-to-end suite so CI never needs real API keys.
# Never enable this in production.
PRICESHELF_DEMO_PROVIDER=0
